# Copiá este archivo como .env.local y completá con los datos de tu proyecto Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Configuración de SDK).
# Si dejás esto vacío, la app corre en MODO DEMO (datos guardados solo en tu navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
